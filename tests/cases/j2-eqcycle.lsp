(PROGN (SYSFLAG 1 NIL) (QUOTE READY))
(DEFINEQ (MKL (LAMBDA (N) (PROG (L) LP (COND ((ZEROP N) (RETURN L)))
                                   (SETQ L (CONS N L)) (SETQ N (SUB1 N)) (GO LP)))))
(PROGN (SETQ X (LIST 1 2 3)) (SETQ Y (LIST 1 2 3)) (QUOTE BUILT))
(PROGN (RPLACD (CDDR X) X) (RPLACD (CDDR Y) Y) (QUOTE CIRCULAR))
(PROGN (EQUAL X Y) (QUOTE UNREACHABLE))
(NLSETQ (MEMBER X (LIST Y Y Y)))
(NLSETQ (SASSOC X (LIST (CONS Y 1))))
(NLSETQ (SUBPAIR (LIST X) (LIST 1) Y))
(EQUAL X X)
(PROGN (SETQ A (MKL 5000)) (SETQ B (MKL 5000)) (QUOTE BIG))
(EQUAL A B)
(PROGN (RPLACA B 999) (QUOTE CHANGED))
(EQUAL A B)
(EQUAL (LIST 1 (LIST 2 3)) (LIST 1 (LIST 2 3)))
(MEMBER (LIST 2 3) (LIST (LIST 1) (LIST 2 3)))
(PROGN (PRINT (QUOTE SURVIVED)) (EXIT))
