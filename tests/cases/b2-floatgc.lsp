(PROGN (SYSFLAG 1 NIL) (QUOTE READY))
(DE MKL2 (N)
  (PROG (I L)
        (SETQ I 0)
        (SETQ L NIL)
   LP   (QUOTIENT (ADD1 I) 9.0)
        (SETQ L (CONS (QUOTIENT (ADD1 I) 8.0) L))
        (SETQ I (ADD1 I))
        (COND ((LESSP I N) (GO LP)))
        (RETURN L)))
(DE BURN (N)
  (PROG (I X)
        (SETQ I 0)
   LP   (SETQ X (QUOTIENT (ADD1 I) 3.0))
        (SETQ I (ADD1 I))
        (COND ((LESSP I N) (GO LP)))
        (RETURN X)))
(PROGN (SETQ BIG (MKL2 1200)) (QUOTE READY))
(LENGTH BIG)
(CAR BIG)
(CAR (CDR BIG))
(PROGN (BURN 4000) (QUOTE READY))
(LENGTH BIG)
(CAR BIG)
(CAR (CDR BIG))
(EXIT)
