                                   (SETQ L (CONS N L)) (SETQ N (SUB1 N)) (GO LP)))))
(PROGN (SETQ BIG (MKL 900)) (QUOTE BUILT))
(PROGN (COPY BIG) (QUOTE UNREACHABLE))
(NLSETQ (COPY BIG))
(LENGTH (COPY (MKL 100)))
(PROGN (PRINT (QUOTE SURVIVED)) (EXIT))
